#!/bin/sh
# Dragonwing boot-time image builder. Runs on EVERY boot (not a one-shot)
# so that an OTA which ships a new cam-test / kiosk source actually rebuilds
# the on-device docker images. Each image is stamped with a hash of its
# read-only /usr source; if the stamp matches, the build is skipped (fast),
# so normal boots are cheap and only an OTA that changed the source triggers
# a rebuild.
#
# IMPORTANT: builds from the read-only, OTA-fresh /usr/share/dragonwing/*
# source -- NOT /root/cam-test, which is a copy-if-absent seed that does NOT
# update on OTA (that was the bug: a QAIRT version bump in the rootfs never
# reached the docker image, so cam-detect kept loading a mismatched skel).
set -u

log() { echo "[dragonwing-firstboot] $*"; }

CAM_SRC=/usr/share/dragonwing/cam-test
KIOSK_SRC=/usr/share/dragonwing/kiosk

src_stamp() {  # hash the files that determine the image (Dockerfile + QNN runtime)
    sha256sum "$@" 2>/dev/null | sha256sum | cut -c1-16
}
img_stamp() {  # the stamp baked into a previously built image, or empty
    docker image inspect "$1" --format '{{ index .Config.Labels "dragonwing.src" }}' 2>/dev/null || true
}

# --- Refresh /root/marketplace CODE from the OTA-fresh baked copy ---
# The marketplace service runs /root/marketplace/marketplace.py, but that tree
# is seeded copy-if-absent (tmpfiles C) so it NEVER updates on OTA. An OTA that
# ships new marketplace code (e.g. camera detection / cam_device_args, NPU
# telemetry) would otherwise never reach the running marketplace -- the device
# keeps executing the stale runtime copy. Refresh the CODE when the baked copy
# differs; state lives elsewhere (/root/apps + /var/lib/dragonwing-*), so this
# only touches marketplace.py / html.py / static.
MP_BAKED=/usr/share/dragonwing/marketplace
MP_RUN=/root/marketplace
if [ -d "$MP_RUN" ] && [ -f "$MP_BAKED/marketplace.py" ] \
   && ! cmp -s "$MP_BAKED/marketplace.py" "$MP_RUN/marketplace.py"; then
    log "refreshing /root/marketplace code from baked (OTA shipped new marketplace.py)"
    cp -a "$MP_RUN/marketplace.py" "$MP_RUN/marketplace.py.bak-firstboot" 2>/dev/null || true
    cp -a "$MP_BAKED/marketplace.py" "$MP_RUN/marketplace.py"
    [ -f "$MP_BAKED/html.py" ] && cp -a "$MP_BAKED/html.py" "$MP_RUN/html.py"
    [ -d "$MP_BAKED/static" ] && mkdir -p "$MP_RUN/static" && cp -a "$MP_BAKED/static/." "$MP_RUN/static/"
fi

# --- rubikpi3-cam-test:npu (base for the cam-detect tile + forks) ---
if [ -f "$CAM_SRC/Dockerfile" ]; then
    want=$(src_stamp "$CAM_SRC/Dockerfile" "$CAM_SRC/qnn-libs/libQnnHtp.so")
    have=$(img_stamp rubikpi3-cam-test:npu)
    if [ "$want" != "$have" ]; then
        log "rebuilding rubikpi3-cam-test:npu (src=$want was=${have:-none})"
        if docker build --label "dragonwing.src=$want" -t rubikpi3-cam-test:npu "$CAM_SRC"; then
            # Re-seed /opt/qnn-libs (bind-mounted into non-cam-detect NPU apps)
            # from the SAME fresh source so the host QNN libs match the image.
            log "reseeding /opt/qnn-libs from fresh source"
            rm -rf /opt/qnn-libs.new && mkdir -p /opt/qnn-libs.new \
                && cp -a "$CAM_SRC/qnn-libs/." /opt/qnn-libs.new/ \
                && rm -rf /opt/qnn-libs && mv /opt/qnn-libs.new /opt/qnn-libs
        else
            log "WARN: rubikpi3-cam-test:npu build failed; will retry next boot"
        fi
    else
        log "rubikpi3-cam-test:npu up to date ($have); skipping"
    fi
else
    log "no cam-test source at $CAM_SRC; skipping"
fi

# --- marketplace-kiosk:latest (HDMI desktop browser; best-effort) ---
if [ -f "$KIOSK_SRC/Dockerfile" ]; then
    kwant=$(src_stamp "$KIOSK_SRC/Dockerfile" "$KIOSK_SRC/launch.sh")
    khave=$(img_stamp marketplace-kiosk:latest)
    if [ "$kwant" != "$khave" ]; then
        log "rebuilding marketplace-kiosk:latest (best-effort)"
        docker build --label "dragonwing.src=$kwant" -t marketplace-kiosk:latest "$KIOSK_SRC" \
            || log "WARN: marketplace-kiosk build failed; will retry next boot"
    else
        log "marketplace-kiosk:latest up to date; skipping"
    fi
fi

# Keep the legacy flag for anything that watches it; no longer gates this unit.
mkdir -p /var/lib && touch /var/lib/dragonwing-firstboot.done
log "done"
